# At least 32 bytes, e.g. `openssl rand -base64 48`
SESSION_SECRET=
PASSCODE_SESSION_DAYS=30
RATE_LIMIT_SALT=
NOMINATIM_CONTACT_EMAIL=
GEOCODE_COUNTRY_CODES=vn
